# Environment of the playground site. The PHP worker adds SS_BASE_URL and SS_DEFAULT_ADMIN_PASSWORD per playground
# (see web/src/php-worker.js); the Node runner sets them as well (see wasm/silverstripe-wasm.mjs).
SS_ENVIRONMENT_TYPE="dev"
SS_DATABASE_CLASS="SQLite3Database"
SS_DATABASE_NAME="silverstripe"
SS_SQLITE_DATABASE_PATH="/var/www/silverstripe/database"
SS_DEFAULT_ADMIN_USERNAME="admin"
# No mail leaves the playground (Silverstripe's default, sendmail, cannot run in WebAssembly).
MAILER_DSN="null://null"
